<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tiene acceso il server di Bussola e lo riavvia se cade. Sostituisci i due percorsi, copia il file in
     ~/Library/LaunchAgents/ e attivalo con:
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.bussola.server.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bussola.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>PERCORSO/DI/node</string>
    <string>PERCORSO/DI/bussola-open/server.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>PERCORSO/DI/bussola-open</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>PERCORSO/DI/bussola-open/logs/server.log</string>
  <key>StandardErrorPath</key><string>PERCORSO/DI/bussola-open/logs/server.log</string>
</dict>
</plist>
